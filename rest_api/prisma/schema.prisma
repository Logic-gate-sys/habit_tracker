generator client {
  provider = "prisma-client"
  output   = "../src/config/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------- HABBIT TRACKER SCHEMA ----------------------
model User {
  id         String   @unique @default(uuid())
  email      String   @unique
  password   String
  user_name  String
  f_name     String?
  m_name     String?
  l_name     String?
  time_zone  String?
  created_at DateTime @default(now())

  habits Habit[] // one user could have 0 or more habits
  tags   Tag[] // user could have 0 or 1 tags 
}

model Tag {
  id         String   @unique @default(uuid())
  user_id    String
  name       String // e.g sports, literature, boxing , beauty, etc
  color      String // hex representation of tag color code 
  created_at DateTime @default(now())

  //relationships 
  habit Habit[]
  user  User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Habit {
  id           String    @unique @default(uuid())
  user_id      String
  tag_id       String   // this specifies which tag a habit sits under 
  title        String
  description  String?   // optional description
  frequency    FREQUENCY
  custom_days  String[] @default([])
  target_value Float
  unit_type    UNIT_TYPE? // OPTIONAL UNIT TYPE 
  unit         String    // e.g., "minutes", "pages": will be validate by middleware
  sleep        Boolean   @default(false) // an attribute to track habits with consecutive inactivity 
  res_counter  Int       @default(0) // set when habit sleeps due to inactivity
  goal_reached Boolean   @default(false) // is the habits goal reached s
  archived     Boolean   @default(false) // is habit currently archieved : archieve is same as sun-set 
  freeze_times DateTime[]   // store times each strap of habit was updated a new one started
  badge        BADGE?    //completion badge 
  streak       Int?   @default(0)// streak begins with intial log 
  streak_history DateTime[] @default([]) // streak history empty at the begining 
  created_at     DateTime  @default(now())


  //relationship
  tag  Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  user User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs Logs[] // one 0:m  habit->logs
}

model Logs {
  id         String    @unique @default(uuid())
  habit_id   String
  value      String // value of the goal achieved 
  note       String? // note of completion
  created_at DateTime  @default(now())
  updated_at DateTime? // when an entry is updated: UTC time only

  habit Habit @relation(fields: [habit_id], references: [id], onDelete: Cascade)
}

//::::::::::::::::: enums ::::::::::::::::::::::::::::::::::
enum BADGE {
  JEDI
  MASTERY
  COLONEL
  JUNIOR // with 4 streak loses
  AMATEUR // with 5 + streak loses
}

enum UNIT_TYPE {
  COUNT
  DURATION
  BOOLEAN
  DEFAULT
}
enum FREQUENCY {
  DAILY
  WEEKLY
  MONTHLY
  OTHER // other includes custom frequencies , like 2 times a week etc, MON,TUE,WEN etc
}
